#!/bin/sh
# ══════════════════════════════════════════════════════════════════════════
# [커밋 게이트 (2026-08-01 신설)] — run_precommit.py 를 **실제로** 부른다.
#
# 🔴 왜 만들었나
#   2026-08-01: `run_precommit.py` 는 `BLOCKING_SUITES` 도 있고 rc=1 도 냈지만
#   **`git commit` 이 그걸 부르는 곳이 0곳**이었다. `.git/hooks` 에는 `.sample` 뿐이었다.
#   ⇒ "차단"이라는 출력 문구만 있고 실제로는 **아무것도 막지 않는 장식**이었다.
#   같은 날 rc=1 상태에서 커밋 `47877a0e` 가 그대로 통과한 것으로 실증됐다.
#
# ⚠ `--no-verify` 로 우회하면 **이 훅은 아예 실행되지 않는다.** 훅 안에서는 막을 수 없다.
#   ⇒ 우회 흔적은 `post-commit` 훅이 남긴다(`.git/hooks/post-commit`).
#     여기서는 "훅이 돌았다"는 표식을 남겨, post-commit 이 그 표식의 유무로 우회를 판별한다.
# ══════════════════════════════════════════════════════════════════════════
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

mkdir -p .git/hooks
# 표식: 이 커밋은 훅을 거쳤다(post-commit 이 읽고 지운다)
date "+%Y-%m-%d %H:%M:%S" > .git/hooks/.precommit_ran

echo "════════ 커밋 게이트: python tests/run_precommit.py ════════"
# 🔴 [2026-08-01] PYTHONIOENCODING 필수 — 없으면 게이트가 **코드와 무관하게** 죽는다.
#   실사고: 훅 콘솔이 cp949 라 `run_precommit.py` 가 이모지(🔴)를 출력하는 순간
#   `UnicodeEncodeError` 로 종료 → rc≠0 → **테스트는 전부 통과했는데 커밋이 막혔다.**
#   ⚠ 이건 "게이트가 일한 것"이 아니라 **게이트 자체의 고장**이다. 둘을 혼동하면
#     진짜 실패를 인코딩 문제로 오해해 `--no-verify` 로 넘기게 된다.
# 🔴 [2026-08-28] **파이썬을 PATH 에만 의존하지 않는다.**
#   실사고: 자동 백업 커밋이 훅에서 막혔는데 원인이
#     `.git/hooks/pre-commit: line 28: python: command not found` 였다.
#   서버 프로세스가 도는 계정의 PATH 에 파이썬이 없다(내 셸에는 있어 재현이 안 됐다).
#   ⇒ 게이트가 「일한 것」이 아니라 **게이트가 실행조차 못 된 것**이다. 둘을 혼동하면 안 된다.
#   ⚠ 폴백 순서: PATH 의 python → py 런처 → 알려진 설치 경로.
#     하나도 없으면 **커밋을 막는다**(게이트를 못 돌린 채 통과시키면 게이트가 없는 것과 같다).
PY="$(command -v python 2>/dev/null || true)"
[ -z "$PY" ] && PY="$(command -v py 2>/dev/null || true)"
[ -z "$PY" ] && [ -x "/c/Users/Administrator/AppData/Local/Programs/Python/Python312/python.exe" ]   && PY="/c/Users/Administrator/AppData/Local/Programs/Python/Python312/python.exe"
if [ -z "$PY" ]; then
  echo "🔴 커밋 차단 — 파이썬을 찾지 못해 게이트를 돌릴 수 없다(PATH·설치 경로 확인)."
  exit 1
fi
OUT="$(PYTHONIOENCODING=utf-8 "$PY" tests/run_precommit.py 2>&1)"
RC=$?
echo "$OUT"
if [ $RC -ne 0 ]; then
  echo ""
  # ── [2026-08-01] 🔴 "정당한 차단" 과 "게이트 고장" 을 **갈라서 출력**한다 ────────────
  #   왜: 오늘 훅이 cp949 콘솔에서 UnicodeEncodeError 로 죽어 rc=1 이 됐다.
  #       **테스트는 전부 통과했는데 커밋이 막혔다.** 그런데 화면에는 그냥 "커밋 차단"만 떠서
  #       내용을 안 보면 "위반이 있나 보다" 하고 `--no-verify` 로 넘기게 된다.
  #   ⚠ 판별: 게이트 스크립트 자체가 예외로 죽으면 출력에 파이썬 `Traceback` 이 남는다.
  #     테스트가 정당하게 실패한 경우에는 run_precommit 이 정리된 요약을 내고 Traceback 은 없다.
  #   ⚠ 어느 쪽이든 **커밋은 막는다**(고장 났다고 통과시키면 게이트가 없는 것과 같다).
  if echo "$OUT" | grep -q "Traceback (most recent call last)"; then
    echo "🟠 게이트 오류 — **테스트 실패가 아니다. 게이트 스크립트 자체가 죽었다.**"
    echo "   ⚠ 위 Traceback 을 볼 것. 코드 위반이 아니라 실행 환경 문제일 수 있다"
    echo "     (실사고 2026-08-01: cp949 콘솔 + 이모지 출력 → UnicodeEncodeError)."
    echo "   🔴 그래도 커밋은 막는다 — 게이트가 판정을 못 한 상태로 통과시키지 않는다."
  else
    echo "🔴 커밋 차단(정당) — 위 실패를 고치고 다시 커밋할 것."
  fi
  echo "   ⚠ --no-verify 로 넘길 수 있으나 그 사실이 logs/hook_bypass.log 에 남는다."
  rm -f .git/hooks/.precommit_ran
  exit 1
fi
echo "✅ 게이트 통과"
exit 0
