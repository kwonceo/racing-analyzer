#!/bin/sh
# [훅 우회 감시 (2026-08-01 신설)] — `--no-verify` 로 게이트를 건너뛴 커밋을 기록한다.
#
# 원리: pre-commit 이 돌면 `.git/hooks/.precommit_ran` 표식을 남긴다.
#   커밋이 끝난 시점에 그 표식이 **없으면** = pre-commit 이 안 돌았다 = 우회했다.
# ⚠ 훅 자체를 지우고 커밋하면 이것도 안 남는다. 완벽한 봉쇄는 불가능하다 —
#   **흔적을 남겨 사후에 보이게 하는 것**이 목적이다(조용한 우회 방지).
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

if [ -f .git/hooks/.precommit_ran ]; then
  rm -f .git/hooks/.precommit_ran
  exit 0
fi

mkdir -p logs
SHA="$(git rev-parse --short HEAD 2>/dev/null)"
SUBJ="$(git log -1 --pretty=%s 2>/dev/null)"
printf '%s  BYPASS(--no-verify)  %s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$SHA" "$SUBJ" >> logs/hook_bypass.log
echo "⚠ 커밋 게이트를 건너뛰었다(--no-verify). logs/hook_bypass.log 에 기록됨: $SHA"
exit 0
